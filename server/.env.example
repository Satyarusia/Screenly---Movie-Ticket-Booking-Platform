PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/screenly?retryWrites=true&w=majority
TMDB_API_KEY=your_tmdb_api_key_here
JWT_SECRET=your_jwt_secret_key_here

# ==============================================================================
# REAL EMAIL DELIVERY CONFIGURATION
# Configure either Option 1 (Gmail App Password) or Option 2 (Custom SMTP)
# ==============================================================================

# Option 1: Gmail Direct with Google App Password (Recommended)
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_16_character_app_password
# EMAIL_FROM="Screenly Box Office" <tickets@screenly.in>

# Option 2: Standard SMTP (SendGrid, Brevo, Mailgun, AWS SES, Resend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_smtp_password
